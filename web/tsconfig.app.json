{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Path aliases */
    "paths": {
      "@/*": ["./src/*"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/env.d.ts"],
  "exclude": ["src/i18n/af.ts", "src/i18n/de.ts", "src/i18n/es.ts", "src/i18n/fr.ts", "src/i18n/ga.ts", "src/i18n/hu.ts", "src/i18n/it.ts", "src/i18n/ja.ts", "src/i18n/ko.ts", "src/i18n/pt.ts", "src/i18n/ru.ts", "src/i18n/tr.ts", "src/i18n/uk.ts", "src/i18n/zh-hant.ts"]
}
